---
import '@fontsource-variable/quicksand';
import '@fontsource/open-sans/400.css';
import '@fontsource/open-sans/600.css';
import '@fontsource/dancing-script/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BarraMovil from '../components/BarraMovil.astro';
import { SITE } from '../data/site';

interface Props {
  titulo: string;
  descripcion?: string;
  noindex?: boolean;
}

const { titulo, descripcion = SITE.descripcion, noindex = false } = Astro.props;
const tituloCompleto =
  titulo === 'inicio'
    ? `${SITE.nombre} — ${SITE.tagline}`
    : `${titulo} — ${SITE.nombre}`;
// Con `build.format: 'file'` el pathname trae la extensión (`/tratamientos.html`);
// la canónica tiene que ser la URL pública, que es la que sirve Pages.
const rutaCanonica = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '');
const urlCanonica = new URL(rutaCanonica, SITE.url).href;
const GTM_ID = import.meta.env.PUBLIC_GTM_ID;
const GA_ID = import.meta.env.PUBLIC_GA_ID;
const ANALYTICS_ENABLED = Boolean(GTM_ID && GA_ID);
---

<!doctype html>
<html lang="es-AR" data-analytics-destination={ANALYTICS_ENABLED ? GA_ID : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={urlCanonica} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:image" content={new URL('/og.jpg', SITE.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dra. Ana Laura Batalles — Odontología estética y restauradora" />
    <meta name="twitter:card" content="summary_large_image" />

    {
      ANALYTICS_ENABLED && (
        <script
          is:inline
          define:vars={{ GTM_ID }}
        >
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != 'dataLayer' ? '&l=' + l : '';
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, 'script', 'dataLayer', GTM_ID);
        </script>
      )
    }
  </head>
  <body>
    {
      ANALYTICS_ENABLED && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="Google Tag Manager"
          />
        </noscript>
      )
    }
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <BarraMovil />

    <script>
      // Aparición sutil de secciones (una sola vez, respeta reduced-motion)
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const secciones = document.querySelectorAll('main section');
        const observador = new IntersectionObserver(
          (entradas) => {
            entradas.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
                observador.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px' }
        );
        secciones.forEach((s, i) => {
          if (i === 0) return; // el hero no se anima
          s.classList.add('revelar');
          observador.observe(s);
        });
      }
    </script>

    <script>
      type AnalyticsValue = string | number | boolean;
      type AnalyticsParams = Record<string, AnalyticsValue>;

      declare global {
        interface Window {
          dataLayer?: unknown[];
          gtag?: (command: 'event', eventName: string, params: AnalyticsParams) => void;
          trackAnalytics?: (eventName: string, params?: AnalyticsParams) => void;
          google_tag_data?: {
            tidr?: {
              destinationArray?: Record<string, { state?: number }[]>;
            };
          };
        }
      }

      const destinoAnalytics = document.documentElement.dataset.analyticsDestination;
      const ruta = window.location.pathname.replace(/\/$/, '') || '/';
      const tipoPagina = ruta === '/'
        ? 'home'
        : ruta === '/tratamientos'
          ? 'treatments'
          : ruta.startsWith('/tratamientos/')
            ? 'treatment_detail'
            : ruta === '/articulos'
              ? 'articles'
              : ruta === '/preguntas-frecuentes'
                ? 'faq'
                : 'other';
      const tratamientoActual = tipoPagina === 'treatment_detail'
        ? decodeURIComponent(ruta.split('/').pop() ?? '')
        : '';

      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () {
        window.dataLayer?.push(arguments);
      };
      window.trackAnalytics = (eventName, params = {}) => {
        if (!destinoAnalytics) return;
        window.gtag?.('event', eventName, {
          page_type: tipoPagina,
          ...(tratamientoActual ? { treatment_id: tratamientoActual } : {}),
          ...params,
          send_to: destinoAnalytics,
        });
      };

      const destinoAnalyticsListo = () => Boolean(
        destinoAnalytics
        && window.google_tag_data?.tidr
          ?.destinationArray?.[destinoAnalytics]
          ?.some(({ state }) => state === 2)
      );

      // Los enlaces internos cambian de documento antes de que GA4 alcance a
      // despachar el evento; se reintenta en destino conservando la URL origen.
      const eventoPendienteKey = 'analytics_pending_navigation_event';
      try {
        const eventoPendiente = window.sessionStorage.getItem(eventoPendienteKey);
        if (eventoPendiente) {
          const { eventName, params, destinationPath, createdAt } = JSON.parse(eventoPendiente) as {
            eventName?: unknown;
            params?: unknown;
            destinationPath?: unknown;
            createdAt?: unknown;
          };
          const destinoActual = `${window.location.pathname}${window.location.search}`;
          const eventoValido = destinationPath === destinoActual
            && typeof createdAt === 'number'
            && Date.now() - createdAt < 30_000;

          if (
            eventoValido
            && typeof eventName === 'string'
            && params
            && typeof params === 'object'
            && destinoAnalytics
          ) {
            const enviarAlInicializar = (intento = 0) => {
              if (destinoAnalyticsListo()) {
                window.gtag?.('event', eventName, {
                  ...(params as AnalyticsParams),
                  send_to: destinoAnalytics,
                });
                window.sessionStorage.removeItem(eventoPendienteKey);
                return;
              }
              if (intento < 300) {
                window.setTimeout(() => enviarAlInicializar(intento + 1), 100);
              }
            };
            enviarAlInicializar();
          } else {
            window.sessionStorage.removeItem(eventoPendienteKey);
          }
        }
      } catch {
        try {
          window.sessionStorage.removeItem(eventoPendienteKey);
        } catch {
          // Analytics no debe afectar la navegación si el storage no está disponible.
        }
      }

      const aSnakeCase = (valor: string) =>
        valor.replace(/[A-Z]/g, (letra) => `_${letra.toLowerCase()}`);

      document.addEventListener('click', (e) => {
        if (!(e.target instanceof Element)) return;
        const elemento = e.target.closest<HTMLElement>('[data-analytics-event]');
        const evento = elemento?.dataset.analyticsEvent;
        if (!elemento || !evento) return;

        const parametros: AnalyticsParams = {};
        Object.entries(elemento.dataset).forEach(([clave, valor]) => {
          if (!clave.startsWith('analytics') || clave === 'analyticsEvent' || valor === undefined) return;
          const nombre = clave.slice('analytics'.length);
          const parametro = aSnakeCase(nombre.charAt(0).toLowerCase() + nombre.slice(1));
          parametros[parametro] = parametro === 'item_position' ? Number(valor) : valor;
        });

        if (elemento instanceof HTMLAnchorElement && /^https?:/.test(elemento.href)) {
          const url = new URL(elemento.href);
          if (url.origin !== window.location.origin) {
            parametros.link_domain = url.hostname.replace(/^www\./, '');
          }
        }

        const urlInterna = elemento instanceof HTMLAnchorElement
          ? new URL(elemento.href, window.location.href)
          : null;
        const navegacionInterna = Boolean(
          destinoAnalytics
          && e instanceof MouseEvent
          && e.button === 0
          && !e.metaKey
          && !e.ctrlKey
          && !e.shiftKey
          && !e.altKey
          && elemento instanceof HTMLAnchorElement
          && !elemento.target
          && !elemento.hasAttribute('download')
          && urlInterna?.origin === window.location.origin
          && (urlInterna.pathname !== window.location.pathname || urlInterna.search !== window.location.search)
        );

        if (navegacionInterna && urlInterna) {
          try {
            window.sessionStorage.setItem(eventoPendienteKey, JSON.stringify({
              eventName: evento,
              destinationPath: `${urlInterna.pathname}${urlInterna.search}`,
              createdAt: Date.now(),
              params: {
                page_type: tipoPagina,
                ...(tratamientoActual ? { treatment_id: tratamientoActual } : {}),
                page_location: new URL(window.location.pathname, window.location.origin).href,
                page_title: document.title,
                destination_path: urlInterna.pathname,
                ...parametros,
              },
            }));
            return;
          } catch {
            // Si el navegador bloquea sessionStorage, se intenta enviar antes de navegar.
          }
        }

        window.trackAnalytics?.(evento, parametros);
      }, { capture: true });
    </script>
  </body>
</html>
