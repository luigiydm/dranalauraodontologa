---
import Icono from './Icono.astro';
import { SITE } from '../data/site';

const TURNSTILE_SITEKEY = import.meta.env.PUBLIC_TURNSTILE_SITEKEY;
---

<section class="seccion seccion--beige">
  <div class="contenedor">
    <h2 class="titulo-seccion" id="contacto">Contacto</h2>
    <p class="bajada">
      Escribinos por el medio que te quede más cómodo y te responderemos a la brevedad.
    </p>

    <div class="contacto__grid">
      <div class="contacto__datos">
        <ul>
          <li>
            <Icono nombre="ubicacion" />
            <a
              href={SITE.mapsLink}
              target="_blank"
              rel="noopener"
              data-analytics-event="outbound_click"
              data-analytics-destination-type="maps"
              data-analytics-link-location="contact_section"
            >{SITE.direccion}</a>
          </li>
          <li>
            <Icono nombre="telefono" />
            <a
              href={SITE.telefonoHref}
              data-analytics-event="contact_click"
              data-analytics-contact-method="phone"
              data-analytics-link-location="contact_section"
            >{SITE.telefono}</a>
          </li>
          <li>
            <Icono nombre="email" />
            <a
              href={SITE.emailHref}
              data-analytics-event="contact_click"
              data-analytics-contact-method="email"
              data-analytics-link-location="contact_section"
            >{SITE.email}</a>
          </li>
          <li>
            <Icono nombre="whatsapp" />
            <a
              href={SITE.whatsapp}
              target="_blank"
              rel="noopener"
              data-analytics-event="contact_click"
              data-analytics-contact-method="whatsapp"
              data-analytics-link-location="contact_section"
            >
              Contactanos por WhatsApp por cualquier consulta o inquietud
            </a>
          </li>
          <li>
            <Icono nombre="reloj" />
            <div class="contacto__horarios">
              <strong>Horarios de atención</strong>
              {SITE.horarios.map((h) => (
                <span>
                  {h.dias}: {h.horas}
                </span>
              ))}
            </div>
          </li>
          <li>
            <Icono nombre="instagram" />
            <a
              href={SITE.instagram}
              target="_blank"
              rel="noopener"
              data-analytics-event="outbound_click"
              data-analytics-destination-type="instagram"
              data-analytics-link-location="contact_section"
            >@draanalaurabatalles</a>
          </li>
          <li>
            <Icono nombre="facebook" />
            <a
              href={SITE.facebook}
              target="_blank"
              rel="noopener"
              data-analytics-event="outbound_click"
              data-analytics-destination-type="facebook"
              data-analytics-link-location="contact_section"
            >/Dra.Batalles</a>
          </li>
        </ul>
      </div>

      <form class="contacto__form" method="POST" action="/api/contact" novalidate data-analytics-form-id="contact_form">
        <label>
          Nombre
          <input type="text" name="nombre" required autocomplete="name" />
        </label>
        <label>
          Email
          <input type="email" name="email" required autocomplete="email" />
        </label>
        <label>
          Mensaje
          <textarea name="mensaje" rows="5" required></textarea>
        </label>
        <!-- honeypot anti-spam -->
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="contacto__hp" />
        {TURNSTILE_SITEKEY && <div class="cf-turnstile" data-sitekey={TURNSTILE_SITEKEY}></div>}
        <button type="submit" class="boton boton--primario">Enviar</button>
        <p class="contacto__estado" role="status" aria-live="polite"></p>
      </form>

      <div class="contacto__mapa">
        <iframe
          src={SITE.mapsEmbed}
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Ubicación del consultorio en Google Maps"></iframe>
      </div>
    </div>
  </div>
</section>

{TURNSTILE_SITEKEY && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<style>
  .contacto__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .contacto__datos ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .contacto__datos li {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    font-size: 0.95rem;
  }

  .contacto__datos li :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
    flex: none;
    margin-top: 0.15rem;
    color: var(--malva-oscuro);
  }

  .contacto__datos a {
    color: var(--tinta);
    text-decoration: none;
  }

  .contacto__datos a:hover {
    color: var(--malva-oscuro);
    text-decoration: underline;
  }

  .contacto__horarios {
    display: grid;
    gap: 0.15rem;
  }

  .contacto__horarios strong {
    font-family: var(--fuente-titulos);
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-bottom: 0.15rem;
  }

  .contacto__form {
    display: grid;
    gap: 1rem;
    background: #fff;
    border-radius: var(--radio);
    padding: 1.6rem;
    box-shadow: var(--sombra);
  }

  .contacto__form label {
    display: grid;
    gap: 0.35rem;
    font-family: var(--fuente-titulos);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .contacto__form input,
  .contacto__form textarea {
    font-family: var(--fuente-texto);
    font-size: 0.95rem;
    padding: 0.65em 0.8em;
    border: 1px solid rgb(68 58 51 / 0.2);
    border-radius: 8px;
    background: var(--crema);
    color: var(--tinta);
    resize: vertical;
  }

  .contacto__form input:focus,
  .contacto__form textarea:focus {
    outline: 2px solid var(--malva);
    border-color: transparent;
  }

  .contacto__hp {
    position: absolute;
    left: -9999px;
  }

  .contacto__estado {
    margin: 0;
    font-size: 0.9rem;
    min-height: 1.4em;
  }

  .contacto__estado.ok {
    color: #2e7d32;
  }

  .contacto__estado.error {
    color: #b3261e;
  }

  .contacto__mapa {
    border-radius: var(--radio);
    overflow: hidden;
    min-height: 340px;
    box-shadow: var(--sombra);
  }

  .contacto__mapa iframe {
    min-height: 340px;
  }

  @media (max-width: 960px) {
    .contacto__grid {
      grid-template-columns: 1fr;
    }

    .contacto__mapa {
      min-height: 280px;
    }

    /* con menos de 16px, iOS hace zoom automático al enfocar un campo */
    .contacto__form input,
    .contacto__form textarea {
      font-size: 16px;
    }
  }
</style>

<script>
  declare global {
    interface Window {
      turnstile?: { reset: (widget?: string) => void };
    }
  }

  const form = document.querySelector<HTMLFormElement>('.contacto__form');
  const estado = document.querySelector<HTMLElement>('.contacto__estado');
  const formId = form?.dataset.analyticsFormId ?? 'contact_form';
  let inicioMedido = false;

  form?.addEventListener('input', (e) => {
    if (inicioMedido || !(e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement)) return;
    if (!['nombre', 'email', 'mensaje'].includes(e.target.name)) return;
    inicioMedido = true;
    window.trackAnalytics?.('contact_form_start', {
      form_id: formId,
      field_name: e.target.name,
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      const campo = form.querySelector<HTMLInputElement | HTMLTextAreaElement>(':invalid');
      window.trackAnalytics?.('contact_form_error', {
        form_id: formId,
        error_type: 'validation',
        field_name: campo?.name ?? 'unknown',
      });
      form.reportValidity();
      return;
    }
    const boton = form.querySelector<HTMLButtonElement>('button[type=submit]');
    if (boton) {
      boton.disabled = true;
      boton.textContent = 'Enviando…';
    }
    if (estado) {
      estado.textContent = '';
      estado.className = 'contacto__estado';
    }

    try {
      const respuesta = await fetch('/api/contact', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      const resultado = await respuesta.json().catch(() => ({})) as {
        ok?: boolean;
        error?: string;
        ignored?: boolean;
      };
      if (!respuesta.ok) {
        window.trackAnalytics?.('contact_form_error', {
          form_id: formId,
          error_type: 'api',
          error_code: resultado.error ?? 'unknown',
          http_status: respuesta.status,
        });
        throw new Error('api_error');
      }
      form.reset();
      if (estado) {
        estado.textContent = 'Tu mensaje ha sido enviado. ¡Gracias por escribirnos!';
        estado.classList.add('ok');
      }
      if (!resultado.ignored) {
        window.trackAnalytics?.('generate_lead', {
          form_id: formId,
          lead_source: 'website',
          contact_method: 'form',
        });
      }
    } catch (error) {
      if (!(error instanceof Error && error.message === 'api_error')) {
        window.trackAnalytics?.('contact_form_error', {
          form_id: formId,
          error_type: 'network',
          error_code: 'request_failed',
        });
      }
      if (estado) {
        estado.textContent =
          'No pudimos enviar el mensaje. Probá de nuevo o escribinos por WhatsApp.';
        estado.classList.add('error');
      }
    } finally {
      // El token de Turnstile se consume en cada verificación: sin reset, un
      // segundo intento fallaría siempre.
      window.turnstile?.reset();
      if (boton) {
        boton.disabled = false;
        boton.textContent = 'Enviar';
      }
    }
  });
</script>
